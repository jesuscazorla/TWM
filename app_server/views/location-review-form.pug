extends layout

block content
    .row.banner.border-bottom.mb-4
        .col-12
            h1 Review #{title}

    .row
        .col-12.col-md-8
            form(action=`/api/locations/${id}/reviews`, method="post", role="form")
                .form-group.row
                    label.col-10.col-sm-2.col-form-label(for="name") Name
                    .col-12.col-sm-10
                        input#name.form-control(name="author",placeholder="Your name", required="required")
                .form-group.row 
                    label.col-10.col-sm-2.col-form-label(for="rating") Rating
                    .col-12.col-sm-2
                        select#rating.form-control.input-sm(name="rating", required="required")
                            option 5
                            option 4
                            option 3
                            option 2
                            option 1
                .form-group.row
                    label.col-10.col-sm-2.col-form-label(for="review") Review
                    .col-sm-10
                        textarea#review.form-control(name="reviewText", rows="5", placeholder="Write your review here", required="required")
                button.btn.btn-primary.float-end Add my review

        .col-12.col-md-4